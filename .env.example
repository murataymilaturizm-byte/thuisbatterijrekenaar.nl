# Voorbeeld-omgevingsvariabelen — kopieer naar .env en vul in.
# GEEN geheimen in de code of in git.

# Webhook/endpoint van de lead-ontvanger (nog niet actief; adapter is een stub)
LEAD_WEBHOOK_URL=

# Analytics wordt pas geladen na cookie-toestemming; ID hier, niet in de code
PUBLIC_ANALYTICS_ID=

# Vercel Deploy Hook-URL (Project Settings → Git → Deploy Hooks)
# Gebruikt door api/trigger-rebuild.js voor de dagelijkse prijs-refresh
DEPLOY_HOOK_URL=

# Geheim voor Vercel Cron (Vercel stuurt dit als Bearer-token mee)
CRON_SECRET=
