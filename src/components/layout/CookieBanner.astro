---
/**
 * Cookie-banner met toestemming vooraf (AVG).
 * Er worden op dit moment GEEN analytics geladen; zodra analytics wordt
 * toegevoegd, mag dat uitsluitend in loadAnalytics() hieronder gebeuren —
 * dus pas ná expliciete toestemming. Voorkeuren staan in een functioneel
 * cookie (geen localStorage).
 */
---

<div
  id="cookie-banner"
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white p-4 shadow-lg"
  role="dialog"
  aria-label="Cookievoorkeuren"
>
  <div class="mx-auto flex max-w-4xl flex-col gap-3 sm:flex-row sm:items-center">
    <p class="flex-1 text-sm text-slate-700">
      Wij gebruiken alleen functionele cookies. Analytische cookies plaatsen wij
      uitsluitend na uw toestemming.
    </p>
    <div class="flex gap-2">
      <button
        id="cookie-weiger"
        class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
      >
        Weigeren
      </button>
      <button
        id="cookie-akkoord"
        class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-700"
      >
        Akkoord
      </button>
    </div>
  </div>
</div>

<script>
  const COOKIE_NAAM = 'cookie_consent';

  function leesConsent(): string | null {
    const match = document.cookie.match(
      new RegExp(`(?:^|; )${COOKIE_NAAM}=([^;]*)`),
    );
    return match?.[1] ?? null;
  }

  function schrijfConsent(waarde: 'ja' | 'nee') {
    const eenJaar = 60 * 60 * 24 * 365;
    document.cookie = `${COOKIE_NAAM}=${waarde}; max-age=${eenJaar}; path=/; SameSite=Lax`;
  }

  function loadAnalytics() {
    // Bewust leeg: hier — en alléén hier — komt later de analytics-loader,
    // zodat er vóór toestemming nooit iets wordt geladen.
  }

  const banner = document.getElementById('cookie-banner');
  const consent = leesConsent();

  if (consent === 'ja') {
    loadAnalytics();
  } else if (consent === null && banner) {
    banner.hidden = false;
    document.getElementById('cookie-akkoord')?.addEventListener('click', () => {
      schrijfConsent('ja');
      banner.hidden = true;
      loadAnalytics();
    });
    document.getElementById('cookie-weiger')?.addEventListener('click', () => {
      schrijfConsent('nee');
      banner.hidden = true;
    });
  }
</script>
