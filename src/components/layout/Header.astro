---
import { SITE } from '../../config/site';

const links = [
  { href: '/', label: 'Rekenaar' },
  { href: '/kennisbank/', label: 'Kennisbank' },
  { href: '/stroomprijzen-vandaag/', label: 'Stroomprijzen' },
  { href: '/saldering-stopt-2027/', label: 'Saldering stopt' },
  { href: '/over-ons/', label: 'Over ons' },
];
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-3 px-4 py-4">
    <a href="/" class="text-lg font-extrabold tracking-tight text-emerald-700">
      {SITE.naam}
    </a>
    <nav aria-label="Hoofdnavigatie">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium text-slate-600">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="hover:text-emerald-700">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
