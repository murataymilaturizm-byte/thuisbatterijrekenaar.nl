---
/** Eenvoudige lay-out voor juridische/informatieve pagina's zonder FAQ-blok. */
import BaseLayout from './BaseLayout.astro';
import { organizationSchema } from '../lib/seo/jsonld';

interface Props {
  title: string;
  description: string;
  h1: string;
}

const { title, description, h1 } = Astro.props;
---

<BaseLayout title={title} description={description} jsonLd={[organizationSchema()]}>
  <article>
    <h1 class="mb-6 text-3xl font-extrabold tracking-tight text-slate-900">
      {h1}
    </h1>
    <div class="prose-body space-y-4 leading-relaxed text-slate-700">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .prose-body :global(h2) {
    margin-top: 2rem;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-slate-900, #0f172a);
  }
  .prose-body :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .prose-body :global(a) {
    text-decoration: underline;
  }
  .prose-body :global(strong) {
    color: var(--color-slate-900, #0f172a);
  }
</style>
