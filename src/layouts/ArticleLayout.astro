---
import BaseLayout from './BaseLayout.astro';
import { LAATST_BIJGEWERKT, datumNl } from '../config/constants';
import { clusterTitel, clusterUrl } from '../config/clusters';
import {
  articleSchema,
  breadcrumbSchema,
  faqPageSchema,
  organizationSchema,
} from '../lib/seo/jsonld';
import type { FaqItem } from '../lib/seo/jsonld';

interface Props {
  title: string;
  description: string;
  h1: string;
  /** FAQ-items: één bron voor zowel het zichtbare blok als het JSON-LD-schema */
  faq: FaqItem[];
  gepubliceerd: string;
  /**
   * Datum waarop deze pagina inhoudelijk is nagelopen (YYYY-MM-DD). Vult
   * dateModified én de zichtbare datum, zodat schema en tekst niet uit elkaar
   * kunnen lopen. Valt terug op LAATST_BIJGEWERKT.
   */
  gecontroleerd?: string;
  /** Cluster, voor het kruimelpad. Zonder cluster vervalt de tussenstap. */
  cluster?: string;
  /**
   * Twee à drie zinnen die de vraag van de pagina direct beantwoorden.
   * Staat bovenaan, is zelfstandig leesbaar en dus citeerbaar.
   */
  kortAntwoord?: string;
  /** YMYL-pagina's (belasting/verzekering/juridisch) krijgen een disclaimerblok */
  ymyl?: boolean;
}

const {
  title,
  description,
  h1,
  faq,
  gepubliceerd,
  gecontroleerd,
  cluster,
  kortAntwoord,
  ymyl = false,
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const gewijzigd = gecontroleerd ?? LAATST_BIJGEWERKT;

const kruimels = [
  { naam: 'Home', url: '/' },
  { naam: 'Kennisbank', url: '/kennisbank/' },
  ...(cluster ? [{ naam: clusterTitel(cluster), url: clusterUrl(cluster) }] : []),
  { naam: h1, url: Astro.url.pathname },
];

const jsonLd = [
  organizationSchema(),
  articleSchema({
    titel: h1,
    beschrijving: description,
    url,
    gepubliceerd,
    gewijzigd,
  }),
  faqPageSchema(faq),
  breadcrumbSchema(kruimels),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <nav aria-label="Kruimelpad" class="mb-4 text-sm text-slate-500">
    <ol class="flex flex-wrap items-center gap-x-2">
      {
        kruimels.map((k, i) => (
          <li class="flex items-center gap-x-2">
            {i > 0 && <span aria-hidden="true">›</span>}
            {i === kruimels.length - 1 ? (
              <span aria-current="page" class="text-slate-700">
                {k.naam}
              </span>
            ) : (
              <a href={k.url} class="hover:underline">
                {k.naam}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <article class="prose-slate max-w-none">
    <h1 class="mb-2 text-3xl font-extrabold tracking-tight text-slate-900">
      {h1}
    </h1>
    <p class="mb-6 text-sm text-slate-500">
      Laatst gecontroleerd: {datumNl(gewijzigd)}
    </p>
    {
      kortAntwoord && (
        <p class="mb-6 rounded-lg border-l-4 border-emerald-600 bg-emerald-50 p-4 text-slate-800">
          <strong>Kort antwoord:</strong> {kortAntwoord}
        </p>
      )
    }
    <div class="article-body space-y-4 leading-relaxed text-slate-700">
      <slot />
    </div>
  </article>

  {
    ymyl && (
      <p class="mt-8 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
        Deze informatie is algemeen van aard en geen fiscaal, juridisch of
        verzekeringsadvies. Raadpleeg bij twijfel de Belastingdienst, uw
        netbeheerder of een adviseur.
      </p>
    )
  }

  <section class="mt-10" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="mb-4 text-2xl font-bold text-slate-900">
      Veelgestelde vragen
    </h2>
    <div class="space-y-3">
      {
        faq.map((item) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-800">
              {item.vraag}
            </summary>
            <p class="mt-2 text-slate-700">{item.antwoord}</p>
          </details>
        ))
      }
    </div>
  </section>

  <aside class="mt-10 rounded-xl bg-emerald-50 p-6 text-center">
    <p class="mb-3 text-lg font-semibold text-emerald-900">
      Wat betekent dit voor uw situatie?
    </p>
    <a
      href="/"
      class="inline-block rounded-lg bg-emerald-600 px-6 py-3 font-bold text-white transition hover:bg-emerald-700"
    >
      Bereken het met de thuisbatterij-rekenaar
    </a>
  </aside>
</BaseLayout>

<style>
  .article-body :global(h2) {
    margin-top: 2rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-slate-900, #0f172a);
  }
  .article-body :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-slate-900, #0f172a);
  }
  .article-body :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .article-body :global(a) {
    text-decoration: underline;
  }
  .article-body :global(strong) {
    color: var(--color-slate-900, #0f172a);
  }
</style>
